# Lab bind
HOST=127.0.0.1
PORT=7870

# Live provider label (documentation only): llamacpp | hf-endpoint | openrouter | custom
LIVE_PROVIDER=llamacpp

# OpenAI-compatible root — with or without /v1 (lab normalizes to …/v1)
#   llama.cpp:     http://127.0.0.1:8080/v1
#   HF endpoint:   https://XXXX.region.cloud.endpoints.huggingface.cloud/v1
#   OpenRouter:    https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# Auth (local llama often empty). HF_TOKEN is accepted as a fallback for OPENAI_API_KEY.
OPENAI_API_KEY=
# HF_TOKEN=

# Model id from GET /v1/models — leave empty to auto-pick the first listed model
OPENAI_MODEL=

# --- helpers ---
# ./scripts/configure-live.sh llamacpp
# ./scripts/configure-live.sh hf-endpoint   # needs HF_ENDPOINT_URL + HF_TOKEN
# ./scripts/serve-llamacpp.sh
# ./scripts/probe-live.sh
# docs/LIVE.md
